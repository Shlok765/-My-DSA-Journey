class Solution(object):
    def countIntersectingIntervals(self, intervals):
        count = 0 

        for i in range (len(intervals)):
            for j in range (i + 1 ,len(intervals)):

                if max( intervals [i][0],intervals [j][0]) <= min (intervals [i][1],intervals [j][1]):
                    count += 1
        return count             


        
