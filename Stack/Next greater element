class Solution(object):
    def nextGreaterElements(self, nums):

        n = len(nums)

        stack = []
        answer = [-1] * n

        for i in range(2 * n - 1, -1, -1):

            index = i % n

            while stack and stack[-1] <= nums[index]:
                stack.pop()

            if stack:
                answer[index] = stack[-1]

            stack.append(nums[index])

        return answer
