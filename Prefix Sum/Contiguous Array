class Solution(object):
    def findMaxLength(self, nums):
        count = 0
        max_length = 0
        first_seen = {0: -1}

        for i in range(len(nums)):

            if nums[i] == 0:
                count -= 1
            else:
                count += 1

            if count in first_seen:
                length = i - first_seen[count]
                max_length = max(max_length, length)
            else:
                first_seen[count] = i

        return max_length
