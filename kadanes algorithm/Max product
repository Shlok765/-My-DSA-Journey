class Solution(object):
    def maxProduct(self, nums):
        current_max= nums[0]
        current_min= nums[0]
        answer = nums[0]

        for num in nums [1:]:
            old_max = current_max
            old_min = current_min

            current_max = max(num,num*old_max,num*old_min)
            current_min = min(num,num*old_max,num*old_min)

            answer = max(answer,current_max)
        return answer     
        
