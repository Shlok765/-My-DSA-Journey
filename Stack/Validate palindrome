class Solution(object):
    def isValid(self, s):

        stack =[]

        for char in s:

            if char =='(':
                stack.append(')')
            elif char =='{':
                stack.append('}')
            elif char == '[':
                stack.append(']')

            else:
                if not stack or stack[-1] != char:
                    return False 
                stack.pop()

        return len(stack)==0                    
       
